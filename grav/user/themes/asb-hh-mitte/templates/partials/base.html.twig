<!doctype html>
<html lang="{{ grav.language.getActive ?: site.default_lang ?: 'de' }}">
<head>
    {% block head %}
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#000000">
        <title>{% if page.title and page.route != home_url %}{{ page.title|e }} · {% endif %}{{ site.title|e }}</title>
        {% include 'partials/metadata.html.twig' %}
        <link rel="canonical" href="{{ page.url(true, true) }}">
        <link rel="icon" type="image/svg+xml" href="{{ url('theme://assets/images/logo-asb.svg') }}">
        {% do assets.addCss('theme://assets/css/screen.css', 100) %}
        {% do assets.addJs('theme://assets/js/site.js', {group: 'bottom', priority: 100}) %}
        {{ assets.css()|raw }}
        {{ assets.js()|raw }}
    {% endblock %}
</head>
<body class="template-{{ page.template|e('html_attr') }}">
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
        <div class="site-shell header-grid">
            <a class="brand" href="{{ home_url }}" aria-label="{{ site.title|e('html_attr') }} – Startseite">
                <img src="{{ url('theme://assets/images/logo-asb.svg') }}" alt="Arbeiter-Samariter-Bund Ortsverband Hamburg-Mitte e.V." width="234" height="98">
            </a>

            <div class="header-navigation">
                <nav class="utility-nav" aria-label="Direktzugänge">
                    <a href="mailto:{{ site.author.email }}">Kontakt</a>
                </nav>

                <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Menü öffnen">
                    <span></span><span></span><span></span>
                </button>

                <nav class="main-nav" id="site-navigation" aria-label="Hauptnavigation">
                    {% include 'partials/navigation.html.twig' %}
                </nav>
            </div>
        </div>
    </header>

    <main id="main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer" id="kontakt">
        <div class="site-shell footer-grid">
            <nav class="footer-navigation" aria-label="Fußnavigation">
                <div class="footer-column">
                    <section class="footer-group">
                        <h2><a href="{{ home_url }}">Startseite</a></h2>
                        <ul>
                            <li><a href="{{ url('/aktuelles') }}">Aktuelles</a></li>
                            <li><a href="{{ url('/termine') }}">Termine</a></li>
                            <li><a href="{{ url('/projekte') }}">Projekte</a></li>
                            <li><a href="{{ url('/schnellzugriff') }}">Schnellzugriff</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/humanitaere-auslandshilfe') }}">Humanitäre Auslandshilfe</a></h2>
                        <ul>
                            <li><a href="{{ url('/humanitaere-auslandshilfe/logistikzentrum-hamburg-rissen') }}">Logistikzentrum Hamburg-Rissen</a></li>
                            <li><a href="{{ url('/humanitaere-auslandshilfe/kfz-werkstatt') }}">KFZ-Werkstatt</a></li>
                            <li><a href="{{ url('/humanitaere-auslandshilfe/fuhrpark') }}">Fuhrpark</a></li>
                            <li><a href="{{ url('/humanitaere-auslandshilfe/internationale-hilfstransporte') }}">Internationale Hilfstransporte</a></li>
                            <li><a href="{{ url('/humanitaere-auslandshilfe/laender-und-partnerprojekte') }}">Länder- und Partnerprojekte</a>: Ukraine, Gambia, Tansania, Nicaragua, Bulgarien, Haiti, Usbekistan, Türkei, Russland, Kamerun</li>
                            <li><a href="{{ url('/humanitaere-auslandshilfe/sachspenden-und-hilfsgueter') }}">Sachspenden und Hilfsgüter</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/soziale-hilfe') }}">Soziale Hilfe</a></h2>
                        <ul>
                            <li><a href="{{ url('/soziale-hilfe/sattmacher-mobil') }}">Sattmacher-Mobil</a></li>
                            <li><a href="{{ url('/soziale-hilfe/tausch-und-schnack-eimsbuettel') }}">Tausch &amp; Schnack Eimsbüttel</a></li>
                            <li><a href="{{ url('/soziale-hilfe/seniorenexpress') }}">Seniorenexpress</a></li>
                            <li><a href="{{ url('/soziale-hilfe/kleidermarkt') }}">Kleidermarkt</a></li>
                            <li><a href="{{ url('/soziale-hilfe/gruppe-der-guten-taten') }}">Gruppe der guten Taten</a></li>
                            <li><a href="{{ url('/soziale-hilfe/weitere-angebote') }}">Weitere aktive soziale Hilfsangebote</a></li>
                        </ul>
                    </section>
                </div>

                <div class="footer-column">
                    <section class="footer-group">
                        <h2><a href="{{ url('/asb-dorf') }}">ASB-Dorf</a></h2>
                        <ul>
                            <li><a href="{{ url('/asb-dorf/projekt-und-ziele') }}">Das Projekt und seine Ziele</a></li>
                            <li><a href="{{ url('/asb-dorf/wohnen') }}">Wohnen für Studierende und Auszubildende</a></li>
                            <li><a href="{{ url('/asb-dorf/ehrenamt-und-bevoelkerungsschutz') }}">Ehrenamt und Bevölkerungsschutz</a></li>
                            <li><a href="{{ url('/asb-dorf/nachhaltige-weiternutzung') }}">Nachhaltige Weiternutzung der Gebäude</a></li>
                            <li><a href="{{ url('/asb-dorf/projektstand') }}">Aktueller Projektstand</a></li>
                            <li><a href="https://asb-dorf.de" target="_blank" rel="noopener noreferrer">Eigene Website: asb-dorf.de</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/halle-15') }}">Halle 15 - Bürgerzentrum in Hamburg-Rissen</a></h2>
                        <ul>
                            <li><a href="{{ url('/halle-15/haus-und-konzept') }}">Das Haus und sein Konzept</a></li>
                            <li><a href="{{ url('/halle-15/angebote-und-gruppen') }}">Angebote und Gruppen</a></li>
                            <li><a href="{{ url('/halle-15/kultur-und-veranstaltungen') }}">Kultur und Veranstaltungen</a></li>
                            <li><a href="{{ url('/halle-15/hallenflohmarkt') }}">Hallenflohmarkt</a></li>
                            <li><a href="{{ url('/halle-15/zweimal-schick') }}">ZWEIMAL SCHICK</a></li>
                            <li><a href="{{ url('/halle-15/repair-cafe-und-werkstatt') }}">Repair-Café und Werkstatt</a></li>
                            <li><a href="{{ url('/halle-15/raeume-und-nutzung') }}">Räume und Nutzungsmöglichkeiten</a></li>
                            <li><a href="{{ url('/halle-15/kooperationen-und-foerderer') }}">Kooperationen und Förderer</a></li>
                            <li><a href="{{ url('/halle-15/weiterentwicklung') }}">Weiterentwicklung des Bürgerzentrums</a></li>
                            <li><a href="https://asb-halle15.de" target="_blank" rel="noopener noreferrer">Eigene Website: asb-halle15.de</a></li>
                        </ul>
                    </section>
                </div>

                <div class="footer-column">
                    <section class="footer-group">
                        <h2><a href="{{ url('/mitmachen-und-helfen') }}">Mitmachen und Helfen</a></h2>
                        <ul>
                            <li><a href="{{ url('/mitmachen-und-helfen/ehrenamt') }}">Ehrenamtliches Engagement</a></li>
                            <li><a href="{{ url('/mitmachen-und-helfen/geldspenden') }}">Geldspenden</a></li>
                            <li><a href="{{ url('/mitmachen-und-helfen/sachspenden-und-hilfsgueter') }}">Sachspenden und Hilfsgüter</a></li>
                            <li><a href="{{ url('/mitmachen-und-helfen/unternehmen-und-sponsoring') }}">Unternehmen und Sponsoring</a></li>
                            <li><a href="{{ url('/mitmachen-und-helfen/kooperationen') }}">Kooperationen</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/ueber-uns') }}">Über uns</a></h2>
                        <ul>
                            <li><a href="{{ url('/ueber-uns/ortsverband') }}">Der Ortsverband</a></li>
                            <li><a href="{{ url('/ueber-uns/vorstand-und-kontrollkommission') }}">Vorstand und Kontrollkommission</a></li>
                            <li><a href="{{ url('/ueber-uns/geschaeftsstelle-und-team') }}">Geschäftsstelle und Team</a></li>
                            <li><a href="{{ url('/ueber-uns/mitgliederverwaltung') }}">Mitgliederverwaltung</a></li>
                            <li><a href="{{ url('/ueber-uns/geschichte') }}">Geschichte</a></li>
                            <li><a href="{{ url('/ueber-uns/satzung-und-leitbild') }}">Satzung und Leitbild</a></li>
                            <li><a href="{{ url('/ueber-uns/presse-und-berichte') }}">Presse und Berichte</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/kontakt-und-service') }}">Kontakt und Service</a></h2>
                        <ul>
                            <li><a href="{{ url('/kontakt-und-service/ansprechpartner') }}">Ansprechpartner</a></li>
                            <li><a href="{{ url('/kontakt-und-service/standorte-und-anfahrt') }}">Standorte und Anfahrt</a></li>
                            <li><a href="{{ url('/kontakt-und-service/kontaktformular') }}">Kontaktformular</a></li>
                            <li><a href="{{ url('/legal/imprint') }}">Impressum</a></li>
                            <li><a href="{{ url('/legal/datenschutz') }}">Datenschutz</a></li>
                        </ul>
                    </section>
                </div>
            </nav>

            <div class="footer-contact">
                <address>
                    <strong>Arbeiter-Samariter-Bund<br>Ortsverband Hamburg-Mitte e.V.</strong>
                    <span>Suurheid 20, Halle 15<br>22559 Hamburg</span>
                    <span>
                        Telefon: <a href="tel:+4940831131">040 831131</a><br>
                        E-Mail: <a href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>
                    </span>
                </address>
                <img src="{{ url('theme://assets/images/logo-asb.svg') }}" alt="ASB Ortsverband Hamburg-Mitte e.V." width="234" height="98">
            </div>
        </div>
    </footer>

    {{ assets.js('bottom')|raw }}
</body>
</html>
