<!doctype html>
<html lang="{{ grav.language.getActive ?: site.default_lang ?: 'de' }}">
<head>
    {% block head %}
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#000000">
        <title>{% if page.title and page.route != home_url %}{{ page.title|e }} · {% endif %}{{ site.title|e }}</title>
        {% include 'partials/metadata.html.twig' %}
        <link rel="canonical" href="{{ page.url(true, true) }}">
        <link rel="icon" type="image/svg+xml" href="{{ url('theme://assets/images/logo-asb.svg') }}">
        {% do assets.addCss('theme://assets/css/screen.css', 100) %}
        {% do assets.addJs('theme://assets/js/site.js', {group: 'bottom', priority: 100}) %}
        {{ assets.css()|raw }}
        {{ assets.js()|raw }}
    {% endblock %}
</head>
<body class="template-{{ page.template|e('html_attr') }}">
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
        <div class="site-shell header-grid">
            <a class="brand" href="{{ home_url }}" aria-label="{{ site.title|e('html_attr') }} – Startseite">
                <img src="{{ url('theme://assets/images/logo-asb.svg') }}" alt="Arbeiter-Samariter-Bund Ortsverband Hamburg-Mitte e.V." width="234" height="98">
            </a>

            <div class="header-navigation">
                <nav class="utility-nav" aria-label="Direktzugänge">
                    <a href="mailto:{{ site.author.email }}">Kontakt</a>
                </nav>

                <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Menü öffnen">
                    <span></span><span></span><span></span>
                </button>

                <nav class="main-nav" id="site-navigation" aria-label="Hauptnavigation">
                    {% include 'partials/navigation.html.twig' %}
                </nav>
            </div>
        </div>
    </header>

    <main id="main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer" id="kontakt">
        <div class="site-shell footer-grid">
            <nav class="footer-navigation" aria-label="Fußnavigation">
                <div class="footer-column">
                    <section class="footer-group">
                        <h2><a href="{{ url('/halle-15') }}">Halle 15</a></h2>
                        <ul>
                            <li><a href="{{ url('/halle-15/begegnungszentrum') }}">Begegnungszentrum</a></li>
                            <li><a href="{{ url('/halle-15/flohmarkt') }}">Flohmarkt</a></li>
                            <li><a href="{{ url('/halle-15/seniorenkaffee') }}">Seniorenkaffee</a></li>
                            <li><a href="{{ url('/halle-15/pfadfinder') }}">Pfadfinder</a></li>
                            <li><a href="{{ url('/halle-15/logistikzentrum') }}">Logistikzentrum</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/gefluechtetenhilfe') }}">Geflüchtetenhilfe</a></h2>
                        <ul>
                            <li><a href="{{ url('/gefluechtetenhilfe/camp-schnackenburg') }}">Camp Schnackenburg</a></li>
                            <li class="footer-indent"><a href="{{ url('/gefluechtetenhilfe/jugendarbeit') }}">Jugendarbeit</a></li>
                            <li class="footer-indent"><a href="{{ url('/gefluechtetenhilfe/ausfluege-events') }}">Ausflüge/Events</a></li>
                            <li class="footer-indent"><a href="{{ url('/gefluechtetenhilfe/soziale-begegnungen') }}">Soziale Begegnungen</a></li>
                            <li class="footer-indent"><a href="{{ url('/gefluechtetenhilfe/sport') }}">Sport</a></li>
                            <li class="footer-indent"><a href="{{ url('/gefluechtetenhilfe/jugendreisen') }}">Jugendreisen</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/tausch-und-schnack') }}">Tausch &amp; Schnack</a></h2>
                        <ul>
                            <li class="footer-indent"><a href="{{ url('/tausch-und-schnack/haushaltsartikelboerse') }}">Haushaltsartikelbörse</a></li>
                            <li class="footer-indent"><a href="{{ url('/tausch-und-schnack/begegnungszentrum') }}">Begegnungszentrum</a></li>
                        </ul>
                    </section>

                    <ul class="footer-standalone-links">
                        <li><a href="{{ url('/sek-schoener-wohnen') }}">SEK Schöner Wohnen</a></li>
                        <li><a href="{{ url('/unterkunftsvermittlung') }}">Unterkunftsvermittlung</a></li>
                        <li><a href="{{ url('/tiernotruf') }}">Tiernotruf</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <ul class="footer-standalone-links footer-standalone-links--top">
                        <li><a href="{{ url('/dolmetscher') }}">Dolmetscher</a></li>
                        <li><a href="{{ url('/pausierende-projekte') }}">Pausierende Projekte</a></li>
                    </ul>

                    <section class="footer-group">
                        <h2><a href="{{ url('/auslandshilfe') }}">Auslandshilfe</a></h2>
                        <ul>
                            <li><a href="{{ url('/auslandshilfe/afrika') }}">Afrika</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/afrika/gambia') }}">Gambia</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/afrika/tansania') }}">Tansania</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/afrika/namibia') }}">Namibia</a></li>
                            <li><a href="{{ url('/auslandshilfe/mittelamerika') }}">Mittelamerika</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/mittelamerika/haiti') }}">Haiti</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/mittelamerika/nicaragua') }}">Nicaragua</a></li>
                            <li><a href="{{ url('/auslandshilfe/asien') }}">Asien</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/asien/russland') }}">Russland</a></li>
                            <li><a href="{{ url('/auslandshilfe/europa') }}">Europa</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/europa/ukraine') }}">Ukraine</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/europa/lettland') }}">Lettland</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/europa/portugal') }}">Portugal</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/europa/armenien') }}">Armenien</a></li>
                            <li class="footer-indent"><a href="{{ url('/auslandshilfe/europa/tuerkei-syrien') }}">Türkei/Syrien</a></li>
                        </ul>
                    </section>
                </div>

                <div class="footer-column">
                    <section class="footer-group">
                        <h2><a href="{{ url('/hilfe-fuer-hamburgerinnen') }}">Hilfe für Hamburger:innen</a></h2>
                        <ul>
                            <li><a href="{{ url('/hilfe-fuer-hamburgerinnen/kleiderkammer') }}">Kleiderkammer</a></li>
                            <li><a href="{{ url('/hilfe-fuer-hamburgerinnen/sattmachermobil') }}">Sattmachermobil</a></li>
                            <li><a href="{{ url('/hilfe-fuer-hamburgerinnen/hamburg-naeht') }}">Hamburg näht</a></li>
                            <li><a href="{{ url('/halle-15') }}">Halle 15</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/hilf-mit') }}">Hilf mit!</a></h2>
                        <ul>
                            <li><a href="{{ url('/hilf-mit/geldspenden') }}">Geldspenden</a></li>
                            <li><a href="{{ url('/hilf-mit/sachspenden') }}">Sachspenden</a></li>
                            <li><a href="{{ url('/hilf-mit/mitmachen') }}">Mitmachen</a></li>
                        </ul>
                    </section>

                    <section class="footer-group">
                        <h2><a href="{{ url('/ueber-uns') }}">Über uns</a></h2>
                        <ul>
                            <li><a href="{{ url('/ueber-uns/vorstand') }}">Vorstand</a></li>
                            <li><a href="{{ url('/ueber-uns/projektleitung') }}">Projektleitung</a></li>
                            <li><a href="{{ url('/ueber-uns/presse') }}">Presse</a></li>
                            <li><a href="{{ url('/ueber-uns/adresse-anfahrt') }}">Adresse/Anfahrt</a></li>
                            <li><a href="{{ url('/ueber-uns/kontakt') }}">Kontakt-Formular</a></li>
                        </ul>
                    </section>

                    <ul class="footer-legal-links">
                        <li><a href="{{ url('/legal/imprint') }}">Impressum</a></li>
                        <li><a href="{{ url('/legal/datenschutz') }}">Datenschutz</a></li>
                    </ul>
                </div>
            </nav>

            <div class="footer-contact">
                <address>
                    <strong>Arbeiter-Samariter-Bund<br>Ortsverband Hamburg-Mitte e.V.</strong>
                    <span>Suurheid 20, Halle 15<br>22559 Hamburg</span>
                    <span>
                        Telefon: <a href="tel:+4940831131">040 831131</a><br>
                        E-Mail: <a href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>
                    </span>
                </address>
                <img src="{{ url('theme://assets/images/logo-asb.svg') }}" alt="ASB Ortsverband Hamburg-Mitte e.V." width="234" height="98">
            </div>
        </div>
    </footer>

    {{ assets.js('bottom')|raw }}
</body>
</html>
